# Resume Builder 9000 - Docker Environment Configuration
# Use this file when running Playwright tests against Docker containers
# Copy relevant sections to your .env file when testing against Docker

# ============================================================================
# Resume Builder 9000 - Docker Environment Configuration
# Use this file when running Playwright tests against Docker containers
# Copy relevant sections to your .env file when testing against Docker

# ============================================================================
# Docker Testing Configuration
# ============================================================================

# When testing against Docker containers, use these URLs:
WEB_BASE=http://localhost:3001
API_BASE=http://localhost:4001

# Playwright port configuration for Docker environment (host-mode)
PLAYWRIGHT_WEB_PORT=3001
PLAYWRIGHT_API_PORT=4001

# Container internal ports (what the services listen on inside containers)
# These must match the PORT values passed to the services
API_PORT=4000
WEB_PORT=3000

# ============================================================================
# Standard Configuration (copy from .env.example if needed)
# ============================================================================

# Test routes (required for E2E testing)
ENABLE_TEST_ROUTES=true
# NOTE: Do NOT commit production secrets. Replace the value below with a local
# placeholder and set the real secret via your environment or CI secret store.
TEST_ROUTE_SECRET=REPLACE_WITH_TEST_ROUTE_SECRET

# Playwright Configuration
PLAYWRIGHT_VERBOSE=true
# For CI/Docker runs, prefer headless; when debugging locally, override in your env
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TEST=true
DEV_E2E_TEST=false

# Database (use separate test database)
# DATABASE_URL points to the container-mounted path used by the API service
DATABASE_URL=/app/data/resume.db
# DB_PATH can be a repo-relative path used by local seeding scripts. Use a repo-relative
# path (no leading './') so the API package resolves it to packages/api/data/... correctly.
DB_PATH=packages/api/data/resume.db

# Node Environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Additional vars copied from .env to ensure parity with local development
# ---------------------------------------------------------------------------

# Feature flags (keep defaults from .env)
ALLOW_EXTERNAL_LLM=false
NEXT_PUBLIC_FEATURE_AI_TAILORING=false
FEATURE_AI_TAILORING=false

# Web / Next.js public URLs for Docker setup
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_WEB_BASE=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1

# CORS and container internal API URL
CORS_ORIGIN=http://localhost:3001
# Internal API URL used by the web container when communicating over the docker network
# Keep this as the service name so the web container can reach the API at port 4000 internally
API_URL=http://api:4000

# Authentication (development defaults)
# NOTE: Do NOT commit real secrets. Use environment variables / secret manager in CI.
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_EXPIRES_IN=24h
NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_SESSION_COOKIE_NAME=session
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=REPLACE_WITH_NEXTAUTH_SECRET

# Email (optional - used by tests if configured)
## IMPORTANT: Do NOT commit real API keys. Replace with a placeholder and set the real key
## in your environment or secrets manager.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@example.com

# Logging + debug
LOG_LEVEL=info
WATCHPACK_POLLING=true
# NOTE: Removed NODE_OPTIONS with --inspect to avoid Node inspector port collisions
# when running tests from IDE test runners. If you need to enable inspection locally,
# set NODE_OPTIONS in your shell, not in the checked-in env file.

# Ensure Playwright flags are explicit for Docker runs
PLAYWRIGHT_VERBOSE=true
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TEST=true
DEV_E2E_TEST=false
PLAYWRIGHT_API_PORT=4001
PLAYWRIGHT_WEB_PORT=3001
DOCKER_TESTING=true
