# Resume Builder 9000 - Docker Environment Configuration
# Use this file when running Playwright tests against Docker containers
# Copy relevant sections to your .env file when testing against Docker

# ============================================================================
# Docker Testing Configuration
# ============================================================================

# When testing against Docker containers, use these URLs:
WEB_BASE=http://localhost:8080
API_BASE=http://localhost:8081

# Playwright port configuration for Docker environment
PLAYWRIGHT_WEB_PORT=8080
PLAYWRIGHT_API_PORT=8081

# ============================================================================
# Standard Configuration (copy from .env.example if needed)
# ============================================================================

# Test routes (required for E2E testing)
ENABLE_TEST_ROUTES=true
# Use the same test secret as local .env so host-side seed scripts and the API container agree
TEST_ROUTE_SECRET=development-test-secret-123

# Playwright Configuration
PLAYWRIGHT_VERBOSE=true
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TEST=true
DEV_E2E_TEST=false

# Database (use separate test database)
# DATABASE_URL points to the container-mounted path used by the API service
DATABASE_URL=/app/data/resume_builder_dev.db
# DB_PATH can be a repo-relative path used by local seeding scripts. Adjust if needed.
DB_PATH=./test-docker-e2e.db

# Node Environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Additional vars copied from .env to ensure parity with local development
# ---------------------------------------------------------------------------

# Feature flags (keep defaults from .env)
ALLOW_EXTERNAL_LLM=false
NEXT_PUBLIC_FEATURE_AI_TAILORING=false
FEATURE_AI_TAILORING=false

# Web / Next.js public URLs for Docker setup
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WEB_BASE=http://localhost:8080
NEXT_TELEMETRY_DISABLED=1

# CORS and container internal API URL
CORS_ORIGIN=http://localhost:8080
API_URL=http://api-dev:4000

# Authentication (development defaults)
JWT_SECRET=change-me-use-strong-secret-in-production
JWT_EXPIRES_IN=24h
NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_SESSION_COOKIE_NAME=session
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=change-me-use-strong-secret-in-production

# Email (optional - used by tests if configured)
RESEND_API_KEY=re_M5GK7BSv_CZPVRFp9LX1DgaFBHiRAtbR8
RESEND_FROM_EMAIL=onboarding@resend.dev

# Logging + debug
LOG_LEVEL=info
WATCHPACK_POLLING=true
NODE_OPTIONS=--inspect=0.0.0.0:9229

# Ensure Playwright flags are explicit for Docker runs
PLAYWRIGHT_VERBOSE=true
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TEST=true
DEV_E2E_TEST=false
PLAYWRIGHT_API_PORT=8081
PLAYWRIGHT_WEB_PORT=8080
DOCKER_TESTING=true
