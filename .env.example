# Feature flags
ALLOW_EXTERNAL_LLM=false

# LLM Configuration (only used if ALLOW_EXTERNAL_LLM=true)
LLM_PROVIDER=
LLM_MODEL=

# API Configuration
NODE_ENV=development

# Email Configuration (optional - falls back to outbox if not configured)
# Get your API key from https://resend.com (free tier: 100 emails/day)
# For testing, you can use: onboarding@resend.dev (no domain verification needed)
# For production, verify your domain and use your own email address
# NOTE: First-time emails from onboarding@resend.dev may go to spam - this is normal
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web Configuration
WEB_BASE=http://localhost:3000
NEXT_PUBLIC_WEB_BASE=http://localhost:3001
API_BASE=http://localhost:4000
NEXT_PUBLIC_API_BASE=http://localhost:4001
NEXT_PUBLIC_FEATURE_AI_TAILORING=false
FEATURE_AI_TAILORING=false
JWT_SECRET=change-me

# Auth Configuration
NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_SESSION_COOKIE_NAME='session'

# Playwright Configuration
PLAYWRIGHT_VERBOSE=true
PLAYWRIGHT_HEADLESS=true

# Test routes (development/test only)
# Set ENABLE_TEST_ROUTES=true to enable test-only endpoints (only enable locally or in CI)
ENABLE_TEST_ROUTES=false
# A secret used to protect test endpoints when ENABLE_TEST_ROUTES is enabled in development
# In CI, set TEST_ROUTE_SECRET via repo secrets. Locally, dev.ps1 can generate one for you.
TEST_ROUTE_SECRET=
