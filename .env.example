# Resume Builder 9000 - Environment Variables Template
# Copy this file to .env and customize for your environment

# ============================================================================
# Feature Flags
# ============================================================================
ALLOW_EXTERNAL_LLM=false
NEXT_PUBLIC_FEATURE_AI_TAILORING=false
FEATURE_AI_TAILORING=false

# LLM Configuration (only used if ALLOW_EXTERNAL_LLM=true)
LLM_PROVIDER=
LLM_MODEL=

# ============================================================================
# Environment Configuration
# ============================================================================
NODE_ENV=development

# ============================================================================
# API Configuration
# ============================================================================
PORT=4000
API_BASE=http://localhost:4000
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Database Configuration
DATABASE_URL=/app/data/resume_builder.db # docker path
DB_PATH=/packages/api/data/resume_builder.db

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# Web Frontend Configuration
# ============================================================================
WEB_BASE=http://localhost:3000
NEXT_PUBLIC_WEB_BASE=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# Authentication Configuration (CHANGE IN PRODUCTION!)
# ============================================================================
JWT_SECRET=change-me-use-strong-secret-in-production
JWT_EXPIRES_IN=24h

NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_SESSION_COOKIE_NAME=session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-use-strong-secret-in-production

# ============================================================================
# Email Configuration (optional - falls back to outbox if not configured)
# ============================================================================
# Get your API key from https://resend.com (free tier: 100 emails/day)
# For testing, you can use: onboarding@resend.dev (no domain verification needed)
# For production, verify your domain and use your own email address
# NOTE: First-time emails from onboarding@resend.dev may go to spam - this is normal
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# Docker Container Configuration
# ============================================================================

# Container hostname configuration
HOSTNAME=0.0.0.0

# Internal API URL for container-to-container communication
API_URL=http://api:4000

# Public API URL for external access
NEXT_PUBLIC_API_URL=http://localhost:4000

# Development-specific hot reload
WATCHPACK_POLLING=true

# Node.js debugging configuration (development only)
# For local debugging only: set NODE_OPTIONS in your shell; avoid committing inspector flags
# NODE_OPTIONS=--inspect=0.0.0.0:9229

# ============================================================================
# Docker Production Overrides (for production deployments)
# ============================================================================
# Uncomment and modify these for production Docker deployments

# NODE_ENV=production
# LOG_LEVEL=warn
# JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
# NEXTAUTH_SECRET=your-super-secure-nextauth-secret-change-this-in-production
# CORS_ORIGIN=https://yourdomain.com
# WEB_BASE=https://yourdomain.com
# NEXT_PUBLIC_WEB_BASE=https://yourdomain.com
# API_BASE=https://api.yourdomain.com
# NEXT_PUBLIC_API_BASE=https://api.yourdomain.com

# ============================================================================
# Playwright Configuration
# ============================================================================
PLAYWRIGHT_VERBOSE=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TEST=false
DEV_E2E_TEST=false

# Playwright Environment URLs (for testing against Docker containers)
# When testing against Docker:
# - WEB_BASE should point to Docker web frontend (port 8080)
# - API_BASE should point to Docker API (port 8081)
# WEB_BASE=http://localhost:8080
# API_BASE=http://localhost:8081

# Playwright port configuration (defaults to development ports if not set)
PLAYWRIGHT_WEB_PORT=3000
PLAYWRIGHT_API_PORT=4000

# Test routes (development/test only)
# Set ENABLE_TEST_ROUTES=true to enable test-only endpoints (only enable locally or in CI)
ENABLE_TEST_ROUTES=false
# A secret used to protect test endpoints when ENABLE_TEST_ROUTES is enabled in development
# In CI, set TEST_ROUTE_SECRET via repo secrets. Locally, dev.ps1 can generate one for you.
TEST_ROUTE_SECRET=
