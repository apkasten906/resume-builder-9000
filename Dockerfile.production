# Multi-stage production build for Resume Builder 9000
# Excludes Playwright and test dependencies for optimal production images

# ============================================================================
# Stage 1: Base dependencies stage
# ============================================================================
FROM node:22-alpine AS base
WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Copy package files for workspace dependencies
COPY package*.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/api/package.json ./packages/api/
COPY apps/web/package.json ./apps/web/

# Copy patches directory for patch-package
COPY patches ./patches

# ============================================================================
# Stage 2: Dependencies for production (no dev dependencies)
# ============================================================================
FROM base AS deps-production
# First install all dependencies to apply patches, then remove dev dependencies
RUN npm install && \
    npm prune --omit=dev --omit=optional && \
    npm cache clean --force

# ============================================================================
# Stage 3: Dependencies for build (includes dev dependencies)
# ============================================================================
FROM base AS deps-build
# Install all dependencies including dev dependencies for building
RUN npm install

# ============================================================================
# Stage 4: Build the core package
# ============================================================================
FROM deps-build AS core-builder
COPY packages/core ./packages/core
WORKDIR /app/packages/core
RUN npm run build

# ============================================================================
# Stage 5: Build the API package
# ============================================================================
FROM deps-build AS api-builder
# Copy built core package
COPY --from=core-builder /app/packages/core ./packages/core
COPY packages/api ./packages/api

WORKDIR /app/packages/api
RUN npm run build

# ============================================================================
# Stage 6: Build the web frontend
# ============================================================================
FROM deps-build AS web-builder
# Copy built core package
COPY --from=core-builder /app/packages/core ./packages/core
COPY apps/web ./apps/web

WORKDIR /app/apps/web
# Set Next.js telemetry to false for production builds
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# ============================================================================
# Stage 7: API Runtime
# ============================================================================
FROM node:22-alpine AS api-runtime
WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S api -u 1001 -G nodejs

# Copy production dependencies
COPY --from=deps-production /app/node_modules ./node_modules
COPY --from=deps-production /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=deps-production /app/packages/api/node_modules ./packages/api/node_modules

# Copy built core package
COPY --from=core-builder /app/packages/core/dist ./packages/core/dist
COPY --from=core-builder /app/packages/core/package.json ./packages/core/package.json

# Copy built API package
COPY --from=api-builder /app/packages/api/dist ./packages/api/dist
COPY --from=api-builder /app/packages/api/package.json ./packages/api/package.json

# Copy database initialization script
COPY packages/api/init-db.cjs ./packages/api/init-db.cjs

# Create data directory with proper permissions
RUN mkdir -p /app/data && chown -R api:nodejs /app
USER api

# Set working directory to API package
WORKDIR /app/packages/api

# Expose API port
EXPOSE 4000

# Health check for API service
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "require('http').get('http://localhost:4000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
# Run database initialization before starting the server
CMD ["sh", "-c", "node init-db.cjs && node dist/index.js"]

# ============================================================================
# Stage 8: Web Frontend Runtime
# ============================================================================
FROM node:22-alpine AS web-runtime
WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 -G nodejs

# Set Next.js environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy production dependencies for Next.js
COPY --from=deps-production /app/node_modules ./node_modules
COPY --from=deps-production /app/apps/web/node_modules ./apps/web/node_modules

# Copy built core package (needed by web app)
COPY --from=core-builder /app/packages/core/dist ./packages/core/dist
COPY --from=core-builder /app/packages/core/package.json ./packages/core/package.json

# Copy built Next.js application
COPY --from=web-builder /app/apps/web/.next ./apps/web/.next
COPY --from=web-builder /app/apps/web/public ./apps/web/public
COPY --from=web-builder /app/apps/web/package.json ./apps/web/package.json
COPY --from=web-builder /app/apps/web/next.config.* ./apps/web/

# Set ownership to non-root user
RUN chown -R nextjs:nodejs /app
USER nextjs

# Set working directory to web app
WORKDIR /app/apps/web

# Expose web port
EXPOSE 3000

# Health check for web service
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "start"]
