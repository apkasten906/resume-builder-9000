# Multi-stage production build for Resume Builder 9000
# Excludes Playwright and test dependencies for optimal production images

# ----------
# Base stage: copy package manifests and patches
# ----------
FROM node:22-alpine AS base
WORKDIR /app

# Install dumb-init for proper signal handling during runtime stages
RUN apk add --no-cache dumb-init

# Copy package files for workspace dependencies
COPY package*.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/api/package.json ./packages/api/
COPY apps/web/package.json ./apps/web/

# Copy patches directory for patch-package
COPY patches ./patches

# ----------
# deps-production: install production dependencies only
# ----------
FROM base AS deps-production
RUN npm install && \
    npm prune --omit=dev --omit=optional && \
    npm cache clean --force

# ----------
# deps-build: install all deps needed for building (includes dev deps)
# ----------
FROM base AS deps-build
RUN npm install

# ----------
# Build core package
# ----------
FROM deps-build AS core-builder
COPY packages/core ./packages/core
WORKDIR /app/packages/core
RUN npm run build

# ----------
# Build API package
# ----------
FROM deps-build AS api-builder
COPY --from=core-builder /app/packages/core ./packages/core
COPY packages/api ./packages/api
WORKDIR /app/packages/api
RUN npm run build

# ----------
# Build web frontend
# ----------
FROM deps-build AS web-builder
COPY --from=core-builder /app/packages/core ./packages/core
COPY apps/web ./apps/web
WORKDIR /app/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# ----------
# API runtime image
# ----------
FROM node:22-alpine AS api-runtime
WORKDIR /app
RUN apk add --no-cache dumb-init

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S api -u 1001 -G nodejs

# Copy production dependencies and built artifacts
COPY --from=deps-production /app/node_modules ./node_modules
COPY --from=deps-production /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=deps-production /app/packages/api/node_modules ./packages/api/node_modules

COPY --from=core-builder /app/packages/core/dist ./packages/core/dist
COPY --from=core-builder /app/packages/core/package.json ./packages/core/package.json

COPY --from=api-builder /app/packages/api/dist ./packages/api/dist
COPY --from=api-builder /app/packages/api/package.json ./packages/api/package.json

# Copy database initialization script if present
COPY packages/api/init-db.cjs ./packages/api/init-db.cjs

# Prepare data directory and set permissions
RUN mkdir -p /app/data && chown -R api:nodejs /app
USER api
WORKDIR /app/packages/api

# Expose API port (default 4000). Can be overridden at runtime if needed.
EXPOSE 4000

# Health check for API service
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:4000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

ENTRYPOINT ["dumb-init", "--"]
# Run database initialization before starting the server (if init script exists).
# Fail fast if init-db.cjs exists and returns a non-zero exit code. This prevents
# the container from starting with an uninitialized database.
CMD ["sh", "-c", "if [ -f ./init-db.cjs ]; then node init-db.cjs; fi && node dist/index.js"]

# ----------
# Web runtime image
# ----------
FROM node:22-alpine AS web-runtime
WORKDIR /app
RUN apk add --no-cache dumb-init
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY --from=deps-production /app/node_modules ./node_modules
COPY --from=deps-production /app/apps/web/node_modules ./apps/web/node_modules

COPY --from=core-builder /app/packages/core/dist ./packages/core/dist
COPY --from=core-builder /app/packages/core/package.json ./packages/core/package.json
COPY --from=web-builder /app/apps/web/.next ./apps/web/.next
COPY --from=web-builder /app/apps/web/public ./apps/web/public
COPY --from=web-builder /app/apps/web/package.json ./apps/web/package.json
# next.config.* is copied as part of the web-builder artifact if present

RUN chown -R nextjs:nodejs /app
USER nextjs
WORKDIR /app/apps/web
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "start"]
