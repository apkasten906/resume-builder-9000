{
  "name": "resume-builder-9000",
  "private": true,
  "description": "A resume orchestration engine that creates tailored, ATS-friendly resumes",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "powershell.exe -ExecutionPolicy Bypass -File ./setup.ps1",
    "seedusers": "node ./scripts/seed-users.js",
    "playwright": "npx playwright",
    "playwright:docker": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/configure-playwright.ps1 -Mode docker",
    "build": "npm --workspaces run build",
    "clean": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/clean.ps1",
    "clean-and-rebuild": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/clean-and-rebuild.ps1",
    "dev": "powershell.exe -ExecutionPolicy Bypass -File ./dev.ps1",
    "dev:ci": "concurrently \"npm run dev --workspace=packages/api\" \"npm run dev --workspace=apps/web\"",
    "test": "npm --workspaces run test",
    "test:watch": "npm --workspaces run test:watch",
    "test:coverage": "npm --workspaces run test:coverage",
    "vitest": "vitest --workspace",
    "vitest:ui": "vitest --workspace --ui",
    "lint": "eslint . --plugin eslint-plugin-local-rules --config .eslintrc.cjs",
    "check-flags": "./scripts/check-flags.ps1",
    "update-deps": "npx npm-check-updates -u && npm install",
    "test:unit": "vitest run",
    "test:unit:verbose": "cross-env TEST_VERBOSE_LOGGING=true vitest run",
    "test:e2e": "cross-env CI=true npx playwright test --config=apps/web/tests/e2e/playwright.config.ts",
    "test:e2e:reuse": "cross-env PLAYWRIGHT_REUSE_EXISTING=true npx playwright test --config=apps/web/tests/e2e/playwright.config.ts",
    "test:e2e:standalone": "npx playwright test --config=apps/web/tests/e2e/playwright.standalone.config.ts",
    "test:all": "npm run test:unit && npm run test:e2e",
    "postinstall": "patch-package",
    "format": "prettier --write .",
    "clear-ts-cache:win": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/clear-ts-cache.ps1 -All",
    "clear-ts-cache:unix": "bash ./scripts/clear-ts-cache.sh --all",
    "clear-ts-cache": "powershell.exe -ExecutionPolicy Bypass -Command \"if ($IsWindows -or $env:OS -like '*Windows*') { npm run clear-ts-cache:win } else { npm run clear-ts-cache:unix }\""
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git"
  },
  "keywords": [
    "resume",
    "ats",
    "job-search",
    "typescript",
    "nextjs"
  ],
  "author": "Resume Builder 9000 Team",
  "license": "MIT",
  "dependencies": {
    "@rb9k/core": "^0.1.0",
    "@types/sqlite3": "^3.1.11",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "file-type": "^18.7.0",
    "mammoth": "^1.10.0",
    "morgan": "^1.10.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "cookie-parser": "^1.4.6",
    "resend": "^6.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vite": "^7.1.5",
    "winston": "^3.17.0",
    "zod": "^4.1.5",
    "zod-openapi": "^5.4.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.32",
    "@playwright/test": "^1.55.1",
    "@types/aria-query": "^5.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.19",
    "@types/estree": "^1.0.8",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/methods": "^1.1.4",
    "@types/mime": "^3.0.4",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/pino": "^7.0.4",
    "@types/qs": "^6.14.0",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^0.17.5",
    "@types/serve-static": "^1.15.8",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^6.1.1",
    "next": "14.2.32",
    "node-fetch": "^2.7.0",
    "patch-package": "^8.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "@types/cookie-parser": "^1.4.3"
  },
  "type": "module"
}
