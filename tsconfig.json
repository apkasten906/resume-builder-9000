{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "packages/core/templates/**/*",
    "**/*.template.ts",
    "**/*.template.js",
    "apps/web/**/*",
    "packages/api/**/*",
    "**/node_modules/**/*",
    "**/dist/**/*"
  ]
}
