{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@rb9k/core/testLogger": ["packages/core/dist/testLogger"],
      "@rb9k/core": ["packages/core/dist/index"]
    }
  },
  "exclude": [
    "packages/core/templates/**/*",
    "**/*.template.ts",
    "**/*.template.js",
    "apps/web/**/*",
    "packages/api/**/*",
    "**/node_modules/**/*",
    "**/dist/**/*"
  ]
}
