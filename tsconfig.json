{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": [],
  "references": [
    { "path": "./apps/web" },
    { "path": "./packages/api" },
    { "path": "./packages/core" }
  ],
  "exclude": [
    "apps/*/node_modules",
    "packages/*/node_modules",
    "apps/*/dist",
    "packages/*/dist",
    "apps/*/.next",
    "apps/*/coverage",
    "packages/*/coverage"
  ]
}
